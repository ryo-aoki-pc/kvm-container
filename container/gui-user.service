[Unit]
Description=Mirror the host user (name, uid/gid, password) into the container's GUI/cockpit user
DefaultDependencies=no
After=local-fs.target
Before=cockpit.socket virtqemud.socket

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/gui-user-setup

[Install]
WantedBy=sysinit.target
