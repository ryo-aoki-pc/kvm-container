#!/bin/sh
# systemd generator: make cockpit.socket listen on the address/port given by kvm.sh.
# The container runs with --network host, so cockpit-ws binds directly on the host; podman's -p cannot be used.
# kvm.sh passes COCKPIT_LISTEN=<bind>:<port> (from COCKPIT_BIND / COCKPIT_PORT) in PID 1's environment; the default
# keeps the previous behaviour of exposing cockpit on localhost only
set -e
dir=$1                                   # "normal" generator output directory
listen=$(tr '\0' '\n' </proc/1/environ | sed -n 's/^COCKPIT_LISTEN=//p')
[ -n "$listen" ] || listen=127.0.0.1:9090
bind=${listen%:*}; port=${listen##*:}
case "$bind" in
  \[*\]) ;;                              # already bracketed
  *:*)   bind="[$bind]" ;;               # bare IPv6 literal such as ::
esac
mkdir -p "$dir/cockpit.socket.d"
cat >"$dir/cockpit.socket.d/listen.conf" <<CONF
# generated by cockpit-listen-generator from COCKPIT_LISTEN=$listen
[Socket]
ListenStream=
ListenStream=$bind:$port
CONF
