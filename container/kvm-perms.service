[Unit]
Description=Fix /dev/kvm, /dev/net/tun and /dev/dri permissions inside the container
DefaultDependencies=no
Before=virtqemud.socket virtqemud.service libvirtd.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'chmod 0666 /dev/kvm /dev/net/tun 2>/dev/null || true; chown root:kvm /dev/kvm 2>/dev/null || true; chmod 0666 /dev/dri/renderD* 2>/dev/null || true; sysctl -qw net.ipv4.ip_forward=1 || true'
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
