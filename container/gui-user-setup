#!/bin/bash
# align the uid/gid of the GUI user (admin) inside the container with the host desktop user
# (the host's /run/user/<uid> is 0700, so the uid must match to open the Wayland/X11 sockets)
# HOST_UID / HOST_GID are passed with podman run -e and can only be read from the environment of PID 1 (systemd)
set -e
user=admin
env_of_pid1() { tr '\0' '\n' </proc/1/environ | sed -n "s/^$1=//p"; }
want_uid=$(env_of_pid1 HOST_UID); want_gid=$(env_of_pid1 HOST_GID)
[ -n "$want_uid" ] || exit 0
[ -n "$want_gid" ] || want_gid=$want_uid
cur_uid=$(id -u "$user"); cur_gid=$(id -g "$user")

if [ "$cur_gid" != "$want_gid" ]; then
  if getent group "$want_gid" >/dev/null; then
    echo "gui-user: $user primary group $cur_gid -> existing gid $want_gid ($(getent group "$want_gid" | cut -d: -f1))"
    usermod -g "$want_gid" "$user"
  else
    echo "gui-user: group $user gid $cur_gid -> $want_gid"
    groupmod -g "$want_gid" "$user"
  fi
fi
if [ "$cur_uid" != "$want_uid" ]; then
  if getent passwd "$want_uid" >/dev/null; then
    echo "gui-user: ERROR uid $want_uid is already used by $(getent passwd "$want_uid" | cut -d: -f1); cannot remap $user" >&2
    exit 1
  fi
  echo "gui-user: $user uid $cur_uid -> $want_uid"
  usermod -u "$want_uid" "$user"
fi
chown -R "$want_uid:$want_gid" "/home/$user"
