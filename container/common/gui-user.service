[Unit]
Description=Create the container's GUI user from the host user (name, uid/gid)
DefaultDependencies=no
After=local-fs.target
# before logind: it reads /var/lib/systemd/linger only at startup, and gui-user-setup creates the linger file
Before=systemd-logind.service virtqemud.socket

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/gui-user-setup

[Install]
WantedBy=sysinit.target
