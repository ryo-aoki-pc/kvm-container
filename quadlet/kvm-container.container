# Quadlet template for kvm-container.service. kvm.sh install-service replaces the names enclosed in at signs with
# the values of the environment variables at run time, and the UNIT_DEPS / GUI marker lines (comment lines) with lines
# generated from the session environment, then installs the result as /etc/containers/systemd/kvm-container.container
[Unit]
Description=qemu-kvm / libvirt / cockpit container (kvm.sh)
# @UNIT_DEPS@

[Container]
ContainerName=@CONTAINER@
HostName=@CONTAINER@
Image=@IMAGE@
PodmanArgs=--privileged --systemd=always
ShmSize=2g
AddDevice=/dev/kvm
AddDevice=/dev/net/tun
PublishPort=@COCKPIT_BIND@:@COCKPIT_PORT@:9090
Volume=@KVM_DATA_DIR@/var-libvirt:/var/lib/libvirt
Volume=@KVM_DATA_DIR@/etc-libvirt:/etc/libvirt
Volume=@KVM_DATA_DIR@/home:/home/admin
Environment=TZ=@TZ@
# host session environment (values at install-service time). XAUTHORITY is found at run time by gui inside the container
# @GUI@

[Service]
# load the kvm module, check the image, seed the data directories
ExecStartPre="@KVM_SH@" prepare
TimeoutStartSec=30min

# uncomment the following to start automatically at boot
#[Install]
#WantedBy=multi-user.target
