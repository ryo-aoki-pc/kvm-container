# template: kvm.sh install-desktop fills @KVM_SH@ with the absolute path of kvm.sh and installs this into ~/.local/share/applications/
[Desktop Entry]
Type=Application
Name=Virt Viewer
Name[ja]=Virt Viewer
GenericName=Virtual Machine Viewer
GenericName[ja]=仮想マシンビューアー
Comment=Show a VM's screen from the qemu-kvm container (the VM is chosen from a list)
Comment[ja]=qemu-kvm コンテナの VM の画面を表示する (一覧から VM を選ぶ)
TryExec=@KVM_SH@
Exec="@KVM_SH@" launch virt-viewer
Icon=virt-viewer
Terminal=false
StartupNotify=false
StartupWMClass=virt-viewer
Categories=System;Emulator;
Keywords=virt-viewer;vm;console;仮想マシン;
