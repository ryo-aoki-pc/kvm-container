# template: kvm.sh install-desktop fills @KVM_SH@ with the absolute path of kvm.sh and installs this into ~/.local/share/applications/
[Desktop Entry]
Type=Application
Name=Firefox
Name[ja]=Firefox
GenericName=Web Browser
GenericName[ja]=ウェブブラウザー
Comment=Firefox in the qemu-kvm container (opens cockpit)
Comment[ja]=qemu-kvm コンテナの Firefox で cockpit (https://localhost:9091) を開く
TryExec=@KVM_SH@
Exec="@KVM_SH@" launch firefox
Icon=firefox
Terminal=false
StartupNotify=false
StartupWMClass=firefox
Categories=Network;WebBrowser;
Keywords=cockpit;browser;web;ブラウザ;
